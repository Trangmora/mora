# Sao chép file này thành .env rồi điền key. Key nào để trống thì tính năng đó dùng chế độ miễn phí.

# ---- AI chấm bài (Claude) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = nhanh & rẻ; medium/high = chấm kỹ hơn
CLAUDE_EFFORT=low

# ---- Giọng đọc tự nhiên (chỉ cần MỘT trong ba) ----
# Mỗi câu chỉ tạo 1 lần (npm run voices) rồi lưu file mp3 trong public/voices, nghe lại không tốn phí.
# Google Cloud Text-to-Speech — có hạn mức miễn phí mỗi tháng
GOOGLE_TTS_API_KEY=
# GOOGLE_TTS_VOICE_FEMALE=it-IT-Neural2-A
# GOOGLE_TTS_VOICE_MALE=it-IT-Neural2-C
# Azure Speech — gói F0 miễn phí mỗi tháng
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_VOICE_FEMALE=it-IT-ElsaNeural
# AZURE_VOICE_MALE=it-IT-DiegoNeural
# ElevenLabs — giọng tự nhiên nhất; nên chọn giọng Ý trong Voice Library rồi dán ID
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_FEMALE=
# ELEVENLABS_VOICE_MALE=

# ---- Ảnh thật (không bắt buộc) ----
# Không có key: tự lấy ảnh miễn phí từ Wikimedia Commons. Có key: ảnh đẹp hơn từ Pexels/Unsplash (đều miễn phí).
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

PORT=5173
